[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-a-long-random-secret"
client_id = "your-cognito-app-client-id"
client_secret = "your-cognito-app-client-secret"
server_metadata_url = "https://cognito-idp.us-east-2.amazonaws.com/your_user_pool_id/.well-known/openid-configuration"

[authorization]
admin_groups = ["usta-portal-admins"]
requester_groups = ["usta-portal-requesters"]

[authorization.approver_groups]
"Tournament Operations" = "usta-tournament-approvers"
"Membership & Participation" = "usta-membership-approvers"
"Player Development" = "usta-player-development-approvers"